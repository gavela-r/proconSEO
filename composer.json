{
    "name": "proconsi/proconseo",
    "description": "Herramienta interna de Proconsi para analizar webs: búsqueda con IA, SEO y accesibilidad.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ProconSEO\\": "src/"
        },
        "files": [
            "src/Shared/funciones.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ProconSEO\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrar": "@php bin/migrar.php",
        "demo": "@php bin/migrar.php --demo",
        "servidor": "@php -S localhost:8090 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
