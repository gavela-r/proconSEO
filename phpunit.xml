<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="proconSEO">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Algunas pruebas crean a propósito datos grandes (por ejemplo, una bomba gzip de 50 MB) para
             comprobar los límites. Con los 128 MB por defecto de PHP en Windows, la batería entera no cabe. -->
        <ini name="memory_limit" value="512M"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
