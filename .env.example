# Copia este fichero como .env y rellena los valores. El .env nunca se sube a GitHub.
APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=proconseo
DB_USER=proconseo
DB_PASS=
# Clave de la API de Google PageSpeed Insights (Parte 1). Pendiente de crear en una cuenta de Proconsi.
PAGESPEED_API_KEY=
# IPs de los proxies de confianza, separadas por comas (SEG-11). Solo si la herramienta va detrás
# de un proxy; si no, déjalo vacío para que nadie pueda falsear su IP con X-Forwarded-For.
PROXIES_DE_CONFIANZA=
